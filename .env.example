DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentflow?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"
STORAGE_PATH="./private-uploads"
MAX_FILE_SIZE="20971520"
MAX_UPLOAD_BATCH_BYTES="78643200"
WORKER_CONCURRENCY="3"
CONFIDENCE_THRESHOLD="75"
# Optional AI assistance. Leave unset to use deterministic local extraction only.
AI_PARSING_ENABLED="false"
# AI_PROVIDER="your-provider"
# AI_API_URL="https://your-approved-provider.example/v1/parse"
# AI_API_KEY="replace-with-provider-key"
# Offline evaluation flag; worker activation uses its own explicit mode below.
RESUME_HYBRID_ENABLED="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_NUEXTRACT_MODEL="hf.co/numind/NuExtract-2.0-2B-GGUF:Q4_K_M"
NUEXTRACT_TIMEOUT_MS="60000"
NUEXTRACT_DOCUMENT_BUDGET_MS="90000"
NUEXTRACT_CONTEXT_TOKENS="2048"
NUEXTRACT_OUTPUT_TOKENS="384"
NUEXTRACT_MAX_INPUT_CHARS="1200"
NUEXTRACT_MAX_CALLS="2"
# Worker experimental modes: off (default), shadow, apply. Enabled modes cap concurrency to 1.
# Both an allowlist (hash OR batch) and a creation cutoff are mandatory for uploads.
RESUME_WORKER_HYBRID_MODE="off"
RESUME_WORKER_HYBRID_HASHES=""
RESUME_WORKER_HYBRID_BATCH_IDS=""
RESUME_WORKER_HYBRID_NEW_AFTER=""
# In Docker, explicitly use http://host.docker.internal:11434 for the host API.
# Optional local Tesseract English data directory. Language data must already exist locally.
# TESSDATA_PATH="./tessdata"

# Optional process-wide 5-second numeric resource samples; no service probes.
WORKER_RESOURCE_DIAGNOSTICS="false"
