DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentflow?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"
STORAGE_PATH="./private-uploads"
MAX_FILE_SIZE="20971520"
MAX_UPLOAD_BATCH_BYTES="78643200"
WORKER_CONCURRENCY="3"
CONFIDENCE_THRESHOLD="75"
# Optional AI assistance. Leave unset to use deterministic local extraction only.
AI_PARSING_ENABLED="false"
# AI_PROVIDER="your-provider"
# AI_API_URL="https://your-approved-provider.example/v1/parse"
# AI_API_KEY="replace-with-provider-key"
# Optional local Tesseract English data directory. Otherwise Tesseract.js downloads it on first OCR use.
# TESSDATA_PATH="./tessdata"
